# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Google AI Studio key (aistudio.google.com > Get API key)
GOOGLE_GENERATIVE_AI_API_KEY=

# Currency your sandbox business account holds (Singapore sandbox accounts hold SGD)
PAYOUT_CURRENCY=SGD
# Optional: comma-separated Gemini fallback chain
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Sandbox personal account that receives payouts
PAYOUT_RECEIVER_EMAIL=

# Owner passcode for approve / reset (the demo uses proofpay-demo)
OWNER_PASSCODE=
# Optional: fixed secret so owner sessions and payee links survive restarts
# SESSION_SECRET=

# Optional: PayPal webhook id. If unset, the app finds the webhook registered for
# PUBLIC_URL (or Render's RENDER_EXTERNAL_URL) + /api/paypal/webhook.
# PAYPAL_WEBHOOK_ID=
# PUBLIC_URL=

# Channel3 product API key (free tier). Without it the buyer agent uses a fixed price list.
CHANNEL3_API_KEY=

# Optional: model chain for the buyer agent (separate free-tier quota from the verifier)
# GEMINI_AGENT_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
